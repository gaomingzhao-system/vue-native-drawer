{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // The playground imports the library by its package name, like the Vite alias does. Without
    // this, TypeScript finds the package through its own `exports` and needs a built `dist/`.
    "paths": { "vue-native-drawer": ["./src/index.ts"] },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*", "playground/**/*.ts", "playground/**/*.vue", "test/**/*.ts"],
  "exclude": ["playground/vite.config.ts"]
}
